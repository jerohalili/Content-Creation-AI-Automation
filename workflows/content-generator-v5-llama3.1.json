{
  "name": "Local-AI-Content-Generator-v5-PUBLIC",
  "nodes": [
    {
      "parameters": {
        "content": "## 🛠️ Public Setup Instructions\n1. Replace `YOUR_TELEGRAM_TOKEN` and `YOUR_CHAT_ID` in all Telegram nodes.\n2. Update `YOUR_ANYTHINGLLM_API_KEY` in the Request nodes.\n3. Configure your Facebook/Instagram `PAGE_ID` and `ACCESS_TOKEN` in the final posting nodes.\n4. Ensure n8n can reach your local AI services (use `host.docker.internal` if on Docker).",
        "height": 260,
        "width": 420,
        "color": 6
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [440, 580],
      "id": "setup-note"
    },
    {
      "parameters": {
        "updates": [
          {
            "action": "delete",
            "field": "preamble"
          }
        ],
        "include": "all",
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [1640, 980],
      "id": "parse-logic-node",
      "name": "Parse Content Response"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3001/api/v1/workspace/content-planner/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_ANYTHINGLLM_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"message\": \"{{ $node[\\\"Build Prompt\\\"].json[\\\"full_prompt\\\"] }}\", \"mode\": \"chat\" }",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1360, 980],
      "id": "llm-request",
      "name": "AnythingLLM – Generate Content"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/botYOUR_TELEGRAM_TOKEN/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"chat_id\": \"YOUR_CHAT_ID\", \"text\": \"🚀 Content generation started for {{ $json.topic }}...\" }",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [900, 980],
      "id": "tg-notify",
      "name": "Telegram – Notify Start"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8188/prompt",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"prompt\": {{ $json.comfy_workflow_json }} }",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1900, 1200],
      "id": "comfy-request",
      "name": "ComfyUI – Queue Image"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/YOUR_FB_PAGE_ID/photos",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"url\": \"{{ $json.image_url }}\", \"caption\": \"{{ $json.caption }}\", \"access_token\": \"YOUR_FB_PAGE_ACCESS_TOKEN\" }",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2800, 800],
      "id": "fb-post",
      "name": "Facebook – Post Photo"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/YOUR_IG_USER_ID/media",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"image_url\": \"{{ $json.image_url }}\", \"caption\": \"{{ $json.caption }}\", \"access_token\": \"YOUR_IG_ACCESS_TOKEN\" }",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2800, 1000],
      "id": "ig-post",
      "name": "Instagram – Post Media"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "approve-content-YOUR-UNIQUE-HASH",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [2200, 900],
      "id": "approval-webhook",
      "name": "Webhook – Telegram Approval"
    }
  ],
  "connections": {
    "Telegram – Notify Start": {
      "main": [
        [
          {
            "node": "AnythingLLM – Generate Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AnythingLLM – Generate Content": {
      "main": [
        [
          {
            "node": "Parse Content Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Content Response": {
      "main": [
        [
          {
            "node": "ComfyUI – Queue Image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "template_id": "local-ai-social-factory-v5"
  }
}